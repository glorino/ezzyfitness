# ============================================
# Ezzy Fitness - Environment Variables
# Copy to .env.local and fill in real values
# NEVER commit .env.local to version control!
# ============================================

# ---- Database (Neon PostgreSQL) ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# ---- Auth ----
AUTH_SECRET=generate-with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

# ---- Uploads ----
UPLOAD_MAX_KB=900
MEDIA_BUDGET_MB=120

# ---- Flutterwave Payments ----
NEXT_PUBLIC_FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxxx-X
FLW_SECRET_HASH=your-webhook-secret-hash

# ---- Email (Resend) ----
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# ---- Error Monitoring (Sentry) ----
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_ORG=your-org
SENTRY_PROJECT=your-project

# ---- AI (Anthropic Claude) ----
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# ---- Site ----
NEXT_PUBLIC_SITE_NAME=Ezzy Fitness
NEXT_PUBLIC_PHONE=+2348000000000
NEXT_PUBLIC_ADDRESS=Ezra Mall, At Ward 3/A, Ugbor Village Area, Benin City, Oredo LGA, Edo State

# ---- Vercel ----
NEXT_PUBLIC_SITE_URL=https://ezzyfitness.vercel.app

# ---- Analytics (optional) ----
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxx
